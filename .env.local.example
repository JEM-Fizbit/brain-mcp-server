# Local-only hosted Brain credentials for one Brain profile.
# Copy to .env.local and fill from the matching owner/project secret custody.
# .env.local is gitignored. Do not mix values from different Brain profiles.
# For the normal two-Brain operator stack, prefer selecting the owner-only
# generated Brain Monitor config instead of maintaining one ambient credential:
# BRAIN_MONITOR_CONFIG_FILE=/absolute/path/to/Brain Monitor.app/Contents/Resources/brain-menubar-config.json

# Exact Brain identity for this database, hosted endpoint, and Fly app tuple.
BRAIN_ID=ai-brain-jem

# Local two-Brain routing tests can use the committed John-only pilot registry.
# Fly uses the image path `/app/config/brain-platform.john-ers-pilot.json`.
BRAIN_PLATFORM_CONFIG=config/brain-platform.john-ers-pilot.json

# Postgres revision store. Prefer a dedicated login role that inherits the
# no-login brain_runtime role from db/migrations/2026-06-14_003_brain_runtime_role.sql.
# Source: Supabase dashboard -> Connect -> Direct/Pooler connection string,
# then replace the username/password with the dedicated runtime login.
# For Supabase pooler URLs, preserve the tenant suffix in the username
# format, e.g. brain_runtime_user.<project-ref>.
BRAIN_REVISION_STORE=postgres
BRAIN_REVISION_DATABASE_URL=PASTE_SUPABASE_POSTGRES_CONNECTION_STRING_HERE
# Exact Supabase project ref encoded in the database URL above. Hosted doctor
# and OAuth smoke commands refuse to connect when this is absent or mismatched.
BRAIN_EXPECTED_SUPABASE_PROJECT_REF=PASTE_EXACT_PROJECT_REF_HERE

# Private artifact storage. URL and bucket names are non-secret.
BRAIN_ARTIFACT_STORE=supabase
BRAIN_ARTIFACT_BYTE_ACCESS=metadata_only
BRAIN_SUPABASE_URL=https://PASTE_EXACT_PROJECT_REF_HERE.supabase.co
BRAIN_SUPABASE_STORAGE_BUCKET=brain-artifacts

# Required only for ingestion/admin byte uploads, such as
# `npm run sources:upload:postgres`. Normal hosted runtime source reads return
# Postgres metadata/extracted text and should leave byte access metadata_only.
# Source: Supabase dashboard -> Project Settings -> API Keys -> Secret keys.
BRAIN_SUPABASE_SERVICE_ROLE_KEY=PASTE_SUPABASE_SECRET_KEY_HERE

# Hosted auth-failure Slack alerting (hosted/Fly only; gated on the bot token).
# Unset BRAIN_SLACK_BOT_TOKEN = alerting is a no-op. On Fly, set the token as a
# secret: `fly secrets set BRAIN_SLACK_BOT_TOKEN=xoxb-... -a jem-brain-mcp`.
# The bot needs chat:write and membership in the warn channel.
# BRAIN_SLACK_BOT_TOKEN=xoxb-...
# BRAIN_SLACK_ALERT_CHANNEL=C0B27NK40H4        # warn -> #claude-ops
# BRAIN_SLACK_ALERT_DM=U06SWS92Y5V             # fail -> operator DM
# BRAIN_AUTH_ALERT_WINDOW_MINUTES=60
# BRAIN_AUTH_ALERT_WARN_THRESHOLD=3
# BRAIN_AUTH_ALERT_FAIL_THRESHOLD=10
# BRAIN_AUTH_ALERT_COOLDOWN_MINUTES=30
# BRAIN_AUTH_ALERT_ENABLED=0                   # set to 0 to disable even with a token
# BRAIN_AUTH_ALERT_AWAIT=1                      # diagnostics only: await the Slack post
# Stale-connector grace window (minutes). A single unregistered client looping
# unknown_client_id on a refresh-token grant longer than this is classified as a
# benign stale connector and downgraded from fail to warn (doctor + alerter).
# BRAIN_HOSTED_MCP_AUTH_STALE_GRACE_MINUTES=10

# Postgres integration test (test/postgres-revision-store.test.mjs). The test is
# DESTRUCTIVE — it applies the schema migration and writes/deletes rows — so it
# never runs against BRAIN_REVISION_DATABASE_URL by default. Point it at a
# throwaway/test database here to run it; only this var triggers the migration apply.
# BRAIN_POSTGRES_TEST_DATABASE_URL=postgres://...throwaway-test-db...
# Escape hatch: run the test against BRAIN_REVISION_DATABASE_URL WITHOUT applying
# the migration (assumes the schema already exists). Use with care — never 1 in CI.
# BRAIN_POSTGRES_TEST_ALLOW_RUNTIME_URL=0

# Optional smoke/runtime flags.
MCP_OAUTH_SIGNING_SECRET=local-smoke-only
MCP_OAUTH_DOCUMENTATION_URL=https://github.com/JEM-Fizbit/brain-mcp-server
BRAIN_HOSTED_BASE_URL=https://PASTE_MATCHING_HOSTED_BRAIN_ENDPOINT_HERE
# Required for the local hosted doctor to verify Fly machine health.
BRAIN_FLY_APP=PASTE_MATCHING_FLY_APP_HERE
BRAIN_HTTP_TIMING_LOGS=1
