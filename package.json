{
  "name": "brain-mcp-server",
  "version": "1.6.1",
  "description": "Generic MCP server for Markdown-based AI Brain context systems",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JEM-Fizbit/brain-mcp-server.git"
  },
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22 <23"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "sync": "node dist/sync/cli.js",
    "sync:watch": "npm run build && node dist/sync/cli.js watch",
    "sync:smoke:postgres": "npm run build && node scripts/smoke-postgres-sync.mjs",
    "sync:canary:postgres": "npm run build && BRAIN_REVISION_STORE=postgres BRAIN_SYNC_INCLUDE_FILES=00_loader.md npm run sync -- push",
    "sync:seed:core:postgres": "npm run build && node scripts/seed-core-postgres.mjs",
    "sync:verify:core:postgres": "npm run build && node scripts/verify-core-postgres.mjs",
    "sync:seed:all-markdown:postgres": "npm run build && node scripts/seed-all-markdown-postgres.mjs",
    "sync:launchd:plist": "node scripts/write-sync-launchd-plist.mjs",
    "sync:helper:install": "node scripts/install-sync-helper-app.mjs",
    "sync:helper:launchd:plist": "node scripts/write-sync-helper-launchd-plist.mjs",
    "sync:menubar:install": "node scripts/install-brain-menubar-app.mjs",
    "sync:menubar:launchd:plist": "node scripts/write-brain-menubar-launchd-plist.mjs",
    "sync:reconcile:duplicate-brain-paths": "node scripts/reconcile-duplicate-brain-paths-postgres.mjs",
    "sync:rebase-state": "npm run build && node dist/sync/cli.js rebase-state",
    "smoke:brain-store:postgres": "npm run build && node scripts/smoke-postgres-brain-store.mjs",
    "smoke:http:postgres": "npm run build && node scripts/smoke-http-postgres-runtime.mjs",
    "smoke:hosted:oauth": "node scripts/smoke-hosted-oauth.mjs",
    "hosted:doctor": "node scripts/hosted-doctor.mjs",
    "deploy:guarded": "node scripts/deploy-guarded.mjs",
    "brain:lint:fix": "node scripts/brain-lint-fix.mjs",
    "hosted:test-drive": "node scripts/hosted-test-drive.mjs",
    "eval:brain:routing": "npm run build && node scripts/eval-brain-routing.mjs",
    "hosted:cockpit": "node scripts/hosted-cockpit.mjs",
    "brain:library": "npm run build && node scripts/brain-library.mjs",
    "hosted:cockpit:launchd:plist": "node scripts/write-cockpit-launchd-plist.mjs",
    "hosted:cockpit:launcher:install": "node scripts/install-cockpit-launcher.mjs",
    "bench:http:postgres": "npm run build && node scripts/benchmark-http-postgres-runtime.mjs",
    "sources:inventory:postgres": "npm run build && node scripts/inventory-source-artifacts-postgres.mjs",
    "sources:upload:postgres": "npm run build && node scripts/upload-source-artifacts-postgres.mjs",
    "sources:refresh-companions:postgres": "npm run build && node scripts/refresh-source-companions-postgres.mjs",
    "sources:upload:postgres:interactive": "bash scripts/run-source-upload-interactive.sh",
    "sources:extract-text:postgres": "npm run build && node scripts/extract-source-text-postgres.mjs",
    "sources:verify-list:postgres": "npm run build && node scripts/verify-postgres-source-list.mjs",
    "sources:compile-reference": "npm run build && node scripts/compile-source-reference.mjs",
    "sources:audit-links": "npm run build && node scripts/audit-source-links.mjs",
    "sources:fix-original-links": "npm run build && node scripts/fix-source-original-links.mjs",
    "brain:audit:destinations": "npm run build && node scripts/audit-semantic-destinations.mjs",
    "sources:backfill-brain-links:postgres": "node scripts/backfill-source-brain-links-postgres.mjs",
    "sources:persist-reference:postgres": "npm run build && node scripts/persist-source-reference-postgres.mjs",
    "smoke:brain-runtime-role": "node scripts/smoke-brain-runtime-role.mjs",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "npm run build && node --test",
    "test:cockpit:e2e": "env -u NO_COLOR playwright test --config=playwright.config.mjs",
    "test:brain-library:e2e": "npm run build && env -u NO_COLOR playwright test --config=playwright.brain-library.config.mjs"
  },
  "keywords": [
    "mcp",
    "ai-brain",
    "markdown",
    "context",
    "claude"
  ],
  "author": "JEM-Fizbit",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@supabase/supabase-js": "^2.108.1",
    "markdown-it": "^14.3.0",
    "pg": "^8.21.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.0",
    "typescript": "^5.8.3"
  }
}
