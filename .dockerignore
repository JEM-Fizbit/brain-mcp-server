# Build input allow-list. Git ignore rules do not constrain Docker's context.
# Keep operator files, Brain bytes, reports and credentials out by default.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!tsconfig.json
!src/**/*.ts
!config/brain-platform.*.json
!config/brain-write-policies.json
!config/monitor-operators.json
!config/monitor-release-manifest.json
!config/monitor-release-assets/appcast.xml
!config/monitor-release-assets/canary.xml
!config/monitor-release-assets/Brain-Monitor-*-arm64.zip
!config/monitor-release-assets/Brain-Monitor-*-x64.zip
!config/prod-ca-2021.crt
!README.md
!LICENSE
!scripts/fly-entrypoint.sh
